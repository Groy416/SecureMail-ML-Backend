# Pull this image from GHCR. IMAGE_TAG is overridden by CI deploys.
GHCR_IMAGE=ghcr.io/groy416/securemail-ml-backend
IMAGE_TAG=latest

# Compose publishes only to the VPS loopback interface for Nginx.
API_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=8000

# Postgres (compose service `db`)
POSTGRES_USER=securemail
POSTGRES_PASSWORD=
POSTGRES_DB=securemail

# Set a long random value; never commit the real value.
SECUREMAIL_API_KEY=
SECUREMAIL_CORS_ORIGINS=https://securemail.monostack.in

# User authentication. Use the same domain users will submit at /login.
AUTH_ALLOWED_EMAIL_DOMAINS=company.com
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_MINUTES=30

# Optional SecureMailScope Agent provider and bounded memory
AGENT_PROVIDER=groq
AGENT_MODEL=
AGENT_API_KEY=
AGENT_BASE_URL=https://api.groq.com/openai/v1
AGENT_TIMEOUT_SECONDS=20
AGENT_MAX_RESPONSE_BYTES=262144
AGENT_MEMORY_MAX_CHARS=6000
AGENT_CONTEXT_MAX_CHARS=24000
