meta {
  name: Validate invalid record
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/validate
  body: json
  auth: none
}

headers {
  content-type: application/json
  Authorization: {{apiKey}}
}

body:json {
  {
    "record": {}
  }
}

tests {
  test("returns a structured validation failure", function() {
    expect(res.status).to.equal(200);
    expect(res.body.valid).to.equal(false);
    expect(res.body.status).to.equal("invalid");
  });
}
