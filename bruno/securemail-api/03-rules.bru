meta {
  name: Known rules
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/rules
  body: none
  auth: none
}

headers {
  Authorization: {{apiKey}}
}

tests {
  test("returns deterministic rules", function() {
    expect(res.status).to.equal(200);
    expect(res.body.rules).to.be.an("array");
    expect(res.body.rules.length).to.be.above(0);
  });
}
