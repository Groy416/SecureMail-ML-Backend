meta {
  name: Bundle metadata
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/bundle
  body: none
  auth: none
}

headers {
  Authorization: {{apiKey}}
}

tests {
  test("returns active bundle metadata", function() {
    expect(res.status).to.equal(200);
    expect(res.body.bundle_version).to.be.a("string");
    expect(res.body.feature_count).to.be.above(0);
  });
}
