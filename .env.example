# SecureMail-ML Backend Environment Template

# Active Model Bundle Path
SECUREMAIL_BUNDLE_PATH=models/Model_XG_RF

# Database URL
DATABASE_URL=sqlite+aiosqlite:///./securemail.db

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
SECUREMAIL_CORS_ORIGINS=*

# Docker host binding (localhost by default; use 0.0.0.0 only for intentional direct access)
API_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=8000

# Required by compose.yaml; set a long random value on the VPS.
SECUREMAIL_API_KEY=
