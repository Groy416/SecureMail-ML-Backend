# SecureMail-ML Backend Environment Template

# Active Model Bundle Path
SECUREMAIL_BUNDLE_PATH=models/Model_XG_RF

# Postgres (compose service `db`; also usable from the host on 127.0.0.1:5432)
POSTGRES_USER=securemail
POSTGRES_PASSWORD=
POSTGRES_DB=securemail
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+asyncpg://securemail:CHANGE_ME@127.0.0.1:5432/securemail

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
SECUREMAIL_CORS_ORIGINS=*

# Docker host binding (localhost by default; use 0.0.0.0 only for intentional direct access)
API_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=8000

# Required by compose.yaml; set a long random value on the VPS.
SECUREMAIL_API_KEY=

# User authentication (required for login/profile APIs)
AUTH_ALLOWED_EMAIL_DOMAINS=company.com
AUTH_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
AUTH_ACCESS_TOKEN_MINUTES=30

# Durable PCAP worker tuning (PCAP bytes live only in the private Docker volume).
SECUREMAIL_CAPTURE_POLL_SECONDS=1
SECUREMAIL_CAPTURE_TIMEOUT_SECONDS=120
