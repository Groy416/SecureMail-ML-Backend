FROM python:3.11-bullseye

# Isolated synthetic-lab client only. Never use this image for production TLS.
RUN apt-get update && apt-get install --no-install-recommends -y \
    build-essential ca-certificates git perl && rm -rf /var/lib/apt/lists/* \
 && git clone --depth 1 --branch OpenSSL_1_0_2u https://github.com/openssl/openssl.git /tmp/openssl \
 && cd /tmp/openssl \
 && ./config --prefix=/opt/legacy-openssl \
 && make -j"$(nproc)" \
 && make install_sw \
 && rm -rf /tmp/openssl
ENV PATH=/opt/legacy-openssl/bin:$PATH
WORKDIR /app
COPY client.py /app/client.py
